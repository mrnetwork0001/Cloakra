# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Starknet Mainnet RPC (free key from https://www.alchemy.com)
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Mainnet chain id
STARKNET_CHAIN_ID=SN_MAIN

# Canonical STRK20 privacy pool (mainnet)
# https://voyager.online/contract/0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
