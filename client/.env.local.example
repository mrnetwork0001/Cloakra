# Copy to client/.env.local — that file is gitignored.
#
# This key ships to the browser (NEXT_PUBLIC_), which is unavoidable for a dapp
# that makes RPC calls client-side. Restrict it by domain in the Alchemy
# dashboard instead of treating it as a secret.
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
